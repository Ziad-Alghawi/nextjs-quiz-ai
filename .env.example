# Copy to .env. Server variables are validated when the app starts (src/lib/env.ts).
GEMINI_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""
# Local Postgres from docker-compose.yml (`npm run db:up`).
# Put the production URL in .env.supabase instead; only `npm run db:migrate:supabase` reads it.
DATABASE_URL="postgres://quiz_ai:quiz_ai@localhost:5432/quiz_ai"
APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
# The Pro prices, monthly and yearly (Stripe dashboard → Product catalog → price ids).
STRIPE_PRICE_ID=""
STRIPE_YEARLY_PRICE_ID=""
# Locally: the signing secret printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""
# Optional: at least 32 characters (e.g. `openssl rand -base64 32`). Without it the daily guest
# cleanup (/api/cron/cleanup-guests) answers 401 and deletes nothing.
CRON_SECRET=""

# Email. Without these, emails (sign-in codes) are printed to the server log, which is fine locally.
# Production: EMAIL_TRANSPORT="smtp" with a Gmail account's app password
# (Google account → Security → 2-Step Verification → App passwords).
EMAIL_TRANSPORT="console"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Quiz AI <you@gmail.com>"
