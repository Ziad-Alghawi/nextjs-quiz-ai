# Copy to .env. Server variables are validated when the app starts (src/lib/env.ts).
GEMINI_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""
# Local Postgres from docker-compose.yml (`npm run db:up`).
# Put the production URL in .env.supabase instead; only `npm run db:migrate:supabase` reads it.
DATABASE_URL="postgres://quiz_ai:quiz_ai@localhost:5432/quiz_ai"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_LOCAL_SECRET=""

# Legacy typo kept in code for backward compatibility.
# You can remove this once your local env uses STRIPE_WEBHOOK_LOCAL_SECRET.
STRIPE_WEBHOOK_LOCAL_SERCRET=""