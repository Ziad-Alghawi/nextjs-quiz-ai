    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
