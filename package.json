    "@radix-ui/react-slot": "^1.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "@uiw/react-heat-map": "^2.3.4",
    "@uiw/react-tooltip": "^4.22.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.3",
